<div class='achievements-modal modal'>
	<span class='modal__close'>
		{{!-- <img src='./src/assets/icons/close.svg' alt='close' /> --}}
	</span>

	<div class='modal__content'>
		<h2 class='modal__title'>Achievements</h2>

		<di class='modal__text achievements'>
			<div class='achievements__inner sword-inner'>
				<p class='achievements__progress-text'>
					<span class='ach-current-score'></span>
					<span class='ach-need-score'>1000</span>
				</p>

				<div class='achievements__progress'>
					<span>score</span>
				</div>

				<ul class='achievements__list'>
					<li id='blue-sword' class='achievements__item'>
						<img src='src/assets/images/sword/sword-blue.png' alt='achievement'
							class='achievements__image' />
					</li>

					<li id='red-sword' class='achievements__item'>
						<img src='src/assets/images/sword/sword-red.png' alt='achievement'
							class='achievements__image' />
					</li>

					<li id='green-sword' class='achievements__item'>
						<img src='src/assets/images/sword/sword-green.png' alt='achievement'
							class='achievements__image' />
					</li>

					<li id='purple-sword' class='achievements__item'>
						<img src='src/assets/images/sword/sword-purple.png' alt='achievement'
							class='achievements__image' />
					</li>
				</ul>
			</div>

			<div class='achievements__inner planet-inner'>
				<p class='achievements__progress-text'>
					<span class='ach-current-score'></span>
					<span class='ach-need-score'>1000</span>
				</p>

				<div class='achievements__progress'>
					<span>planetracker</span>
				</div>

				<ul class='achievements__list'>
					<li id='first-planet' class='achievements__item'>
						<img src='src/assets/entities/planet/planet4.png' alt='achievement'
							class='achievements__image' />
					</li>

					<li id='second-planet' class='achievements__item'>
						<img src='src/assets/entities/planet/planet5.png' alt='achievement'
							class='achievements__image' />
					</li>

					<li id='third-planet' class='achievements__item'>
						<img src='src/assets/entities/planet/planet6.png' alt='achievement'
							class='achievements__image' />
					</li>

					<li id='fourth-planet' class='achievements__item'>
						<img src='src/assets/entities/planet/planet7.png' alt='achievement'
							class='achievements__image' />
					</li>
				</ul>
			</div>
		</di>
	</div>
</div>